# Build or load this image before starting the stack.
AGENT_WECHAT_IMAGE=agent-wechat:amd64
AGENT_WECHAT_CONTAINER_NAME=agent-wechat

# Keep both values stable across container recreation. Use a locally
# administered MAC that is unique on the Docker network.
AGENT_WECHAT_HOSTNAME=agent-wechat-nas
AGENT_WECHAT_MAC_ADDRESS=02:00:00:00:00:01

# The API is published on localhost only. OpenClaw reaches the service through
# the external Docker network below.
AGENT_WECHAT_PORT=6174
OPENCLAW_NETWORK=openclaw_default

# Relative paths are resolved from deploy/nas. Absolute NAS paths can be used
# in the private .env file, but should never be committed.
AGENT_WECHAT_DATA_DIR=./data
AGENT_WECHAT_HOME_DIR=./wechat-home
AGENT_WECHAT_TOKEN_FILE=./secrets/auth-token

# Optional transparent proxy, for example socks5://host:port.
PROXY=
